    glTexCoord2d(1,0); glVertex2i(0 + width, 0);
    glTexCoord2d(1,1); glVertex2i(0 + width, 0 + height);
    glTexCoord2d(0,1); glVertex2i(0, 0 + height);
    glEnd();
    glDisable(GL_TEXTURE_2D);

