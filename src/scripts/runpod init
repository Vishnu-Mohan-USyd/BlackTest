// Installs basics, Cuda and FFMPEG essentials
yes | sudo apt update && yes | sudo apt upgrade && yes | sudo apt-get install build-essential && yes | sudo apt-get install linux-headers-$(uname -r) && yes | sudo apt install nvidia-cuda-toolkit && yes | sudo apt-get install xorg-dev libglu1-mesa-dev ffmpeg doxygen libavcodec-dev libavformat-dev libavfilter-dev libavutil-dev libavdevice-dev

// In case there isn't chrome :
wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && yes | sudo apt install ./google-chrome-stable_current_amd64.deb && google-chrome https://www.jetbrains.com/clion/download/download-thanks.html --no-sandbox &>/dev/null & sleep 50 && sudo pkill -9 chrome && tar -xvf '/home/kasm-user/Downloads/CLion-2022.3.2.tar.gz' && cd '/home/kasm-user/clion-2022.3.2/bin' && echo 'export BROSWER=/usr/bin/google-chrome --no-sandbox' >> ~/.bashrc && sh clion.sh

and then replace preferred web application with this :
/usr/bin/google-chrome --no-sandbox

// GPG Key for Ubuntu
sudo apt-key adv --fetch-keys https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/3bf863cc.pub
For CUDA 12.0

- wget https://developer.download.nvidia.com/compute/cuda/12.0.0/local_installers/cuda_12.0.0_525.60.13_linux.run
- sudo sh cuda_12.0.0_525.60.13_linux.run
- nano .bashrc
- export PATH=/usr/local/cuda-12.0/bin${PATH:+:${PATH}}
- export LD_LIBRARY_PATH=/usr/local/cuda-12.0/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
