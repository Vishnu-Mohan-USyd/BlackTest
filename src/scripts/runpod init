// Installs basics, Cuda and FFMPEG essentials
yes | sudo apt update && yes | sudo apt upgrade && yes | sudo apt-get install build-essential && yes | sudo apt-get install linux-headers-$(uname -r) && yes | sudo apt-get install xorg-dev libglu1-mesa-dev ffmpeg doxygen libavcodec-dev libavformat-dev libavfilter-dev libavutil-dev libavdevice-dev gnuplot-x11 && wget https://developer.download.nvidia.com/compute/cuda/12.0.0/local_installers/cuda_12.0.0_525.60.13_linux.run && sudo sh cuda_12.0.0_525.60.13_linux.run

